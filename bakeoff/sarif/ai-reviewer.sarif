{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ai-reviewer",
          "informationUri": "https://github.com/swasik/itsm-2026-template",
          "rules": [
            {
              "id": "path-join",
              "name": "path-join",
              "shortDescription": {
                "text": "path-join"
              },
              "properties": {
                "tags": [
                  "CWE-22"
                ]
              }
            },
            {
              "id": "random-token",
              "name": "random-token",
              "shortDescription": {
                "text": "random-token"
              },
              "properties": {
                "tags": [
                  "CWE-338"
                ]
              }
            },
            {
              "id": "pickle-cookie",
              "name": "pickle-cookie",
              "shortDescription": {
                "text": "pickle-cookie"
              },
              "properties": {
                "tags": [
                  "CWE-502"
                ]
              }
            },
            {
              "id": "sql-fstring",
              "name": "sql-fstring",
              "shortDescription": {
                "text": "sql-fstring"
              },
              "properties": {
                "tags": [
                  "CWE-89"
                ]
              }
            },
            {
              "id": "hardcoded-jwt",
              "name": "hardcoded-jwt",
              "shortDescription": {
                "text": "hardcoded-jwt"
              },
              "properties": {
                "tags": [
                  "CWE-798"
                ]
              }
            },
            {
              "id": "curl-password",
              "name": "curl-password",
              "shortDescription": {
                "text": "curl-password"
              },
              "properties": {
                "tags": [
                  "CWE-798"
                ]
              }
            },
            {
              "id": "hardcoded-token",
              "name": "hardcoded-token",
              "shortDescription": {
                "text": "hardcoded-token"
              },
              "properties": {
                "tags": [
                  "CWE-798"
                ]
              }
            },
            {
              "id": "old-pin",
              "name": "old-pin",
              "shortDescription": {
                "text": "old-pin"
              },
              "properties": {
                "tags": [
                  "CWE-1395"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "path-join",
          "level": "warning",
          "message": {
            "text": "filename from the request path is joined unchecked; ../ leaves the attachment store."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/app/attachment_read.py"
                },
                "region": {
                  "startLine": 9,
                  "endLine": 10
                }
              }
            }
          ],
          "properties": {
            "class": "path-traversal"
          }
        },
        {
          "ruleId": "random-token",
          "level": "warning",
          "message": {
            "text": "Reset tokens come from random, a predictable generator; use secrets."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/app/reset_tokens.py"
                },
                "region": {
                  "startLine": 10,
                  "endLine": 10
                }
              }
            }
          ],
          "properties": {
            "class": "weak-crypto"
          }
        },
        {
          "ruleId": "pickle-cookie",
          "level": "warning",
          "message": {
            "text": "pickle.loads on cookie data; the HMAC key is a literal in the source."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/app/session_store.py"
                },
                "region": {
                  "startLine": 15,
                  "endLine": 15
                }
              }
            }
          ],
          "properties": {
            "class": "deserialization"
          }
        },
        {
          "ruleId": "sql-fstring",
          "level": "warning",
          "message": {
            "text": "SQL text built with an f-string."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/app/columns.py"
                },
                "region": {
                  "startLine": 11,
                  "endLine": 11
                }
              }
            }
          ],
          "properties": {
            "class": "injection"
          }
        },
        {
          "ruleId": "hardcoded-jwt",
          "level": "warning",
          "message": {
            "text": "A JWT is committed to the repository."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/app/token_fixtures.py"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 3
                }
              }
            }
          ],
          "properties": {
            "class": "secret"
          }
        },
        {
          "ruleId": "curl-password",
          "level": "warning",
          "message": {
            "text": "A password on a curl command line."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/config/backup.sh"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 3
                }
              }
            }
          ],
          "properties": {
            "class": "secret"
          }
        },
        {
          "ruleId": "hardcoded-jwt",
          "level": "warning",
          "message": {
            "text": "A long-lived bearer token is committed."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/config/cmdb_token.py"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 3
                }
              }
            }
          ],
          "properties": {
            "class": "secret"
          }
        },
        {
          "ruleId": "hardcoded-token",
          "level": "warning",
          "message": {
            "text": "A GitHub personal access token is committed."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/config/github.py"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 3
                }
              }
            }
          ],
          "properties": {
            "class": "secret"
          }
        },
        {
          "ruleId": "old-pin",
          "level": "warning",
          "message": {
            "text": "An old release with known advisories: PyYAML."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/requirements.txt"
                },
                "region": {
                  "startLine": 1,
                  "endLine": 1
                }
              }
            }
          ],
          "properties": {
            "class": "vulnerable-dependency"
          }
        },
        {
          "ruleId": "old-pin",
          "level": "warning",
          "message": {
            "text": "An old release with known advisories: urllib3."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/requirements.txt"
                },
                "region": {
                  "startLine": 2,
                  "endLine": 2
                }
              }
            }
          ],
          "properties": {
            "class": "vulnerable-dependency"
          }
        }
      ],
      "properties": {
        "model": "claude-opus-5-5 in the course's authoring session - a MECHANICS TEST of the local route, not a blind review: this model also wrote the pool",
        "route": "local"
      }
    }
  ]
}
